{
  "name": "wtrlab-scraper-bot",
  "version": "1.0.0",
  "description": "Production-ready Telegram bot + Express API that scrapes WTR-Lab novels into EPUB/TXT with zero-drop / zero-duplicate chapter verification.",
  "private": true,
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "assemble": "node scripts/assemble.mjs",
    "build": "npm run assemble && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "npm run assemble && tsx backend/index.ts",
    "typecheck": "npm run assemble && tsc -p tsconfig.json --noEmit",
    "test": "tsx test/live_wtrlab_verify.ts"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
