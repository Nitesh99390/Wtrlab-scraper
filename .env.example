# ============================================================================
# WTR-Lab Telegram Bot - environment variables
# Copy to `.env` for local / VPS use. On Render set them in the dashboard.
# ============================================================================

# ---- REQUIRED --------------------------------------------------------------
# Token from @BotFather (https://t.me/BotFather)
BOT_TOKEN=

# ---- Server ----------------------------------------------------------------
# HTTP port for /health + /api/wtrlab/* (Render injects PORT automatically)
PORT=3000
# Where caches / chat preferences are stored. On Render attach a disk and
# point this at the mount path (e.g. /var/data) to survive restarts.
DATA_DIR=./.runtime

# ---- Telegram transport ----------------------------------------------------
# false = long polling (default; works anywhere, incl. VPS behind NAT)
# true  = webhook (needs a public HTTPS URL; recommended on Render free tier)
USE_WEBHOOK=false
# Public https URL of this service, no trailing slash. On Render this is picked
# up automatically from RENDER_EXTERNAL_URL, so you can leave it empty there.
PUBLIC_URL=

# ---- Security (optional but recommended) -----------------------------------
# Comma-separated Telegram chat IDs allowed to use the bot (empty = everyone)
ALLOWED_CHAT_IDS=
# If set, every /api/* request must send `Authorization: Bearer <token>`
# (or `X-Api-Key: <token>`). /health stays public.
API_AUTH_TOKEN=

# ---- Optional upstream keys ------------------------------------------------
# r.jina.ai key - raises the reader rate limit (https://jina.ai/reader)
JINA_API_KEY=
# Gemini key - better Hindi translation. Without it Google Translate is used.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---- Tuning (optional) -----------------------------------------------------
MAX_CONCURRENT_JOBS=2
MAX_JOBS_PER_CHAT=1
SHUTDOWN_GRACE_MS=20000
# Defaults for new chats: en|hi, web|webplus|ai, epub|txt
DEFAULT_LANGUAGE=en
DEFAULT_SERVICE_MODE=ai
DEFAULT_FORMAT=epub
DEBUG=false
